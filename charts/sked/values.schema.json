{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^([0-9]|[1-9][0-9]|100)%$" }
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rbac": {
      "type": "object",
      "properties": { "create": { "type": "boolean" } }
    },
    "controller": {
      "type": "object",
      "properties": {
        "leaderElection": { "type": "boolean" },
        "workloadNamespace": { "type": "string" },
        "enableHTTP2": { "type": "boolean" },
        "reconcileTimeout": { "type": "string", "minLength": 1 },
        "maxConcurrentReconciles": { "type": "integer", "minimum": 1 },
        "reconcileRateLimitQPS": { "type": "number", "exclusiveMinimum": 0 },
        "reconcileRateLimitBurst": { "type": "integer", "minimum": 1 },
        "reconcileRetryBaseDelay": { "type": "string", "minLength": 1 },
        "reconcileRetryMaxDelay": { "type": "string", "minLength": 1 },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trustPolicy": {
      "type": "object",
      "properties": {
        "existingConfigMap": { "type": "string" },
        "namespace": { "type": "string" },
        "key": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "policy": { "type": ["object", "null"] }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerRef": { "type": "object" }
          }
        },
        "secretName": { "type": "string" },
        "caBundle": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secure": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "tlsConfig": { "type": "object" }
          }
        },
        "readerSubjects": { "type": "array", "items": { "type": "object" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metricsNamespaceSelector": { "type": "object" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["maxSkew", "topologyKey", "whenUnsatisfiable", "labelSelector"],
        "properties": {
          "maxSkew": { "type": "integer", "minimum": 1 },
          "topologyKey": { "type": "string", "minLength": 1 },
          "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] },
          "labelSelector": { "type": "object" }
        }
      }
    },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } }
  }
}
